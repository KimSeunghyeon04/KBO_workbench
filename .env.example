POSTGRES_USER=kbo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=kbo
KBO_DATA_DIR=./.data
KBO_WEB_PORT=8080
KBO_DB_PORT=5433
KBO_POSTGRES_VOLUME_NAME=kbo-workbench-postgres-v3
KBO_ANALYST_USER=kbo_analyst
KBO_ANALYST_PASSWORD=replace-with-a-separate-read-only-password
KBO_COLLECTION_CONCURRENCY=1
KBO_NAVER_MAX_ATTEMPTS=3
KBO_NAVER_REQUESTS_PER_SECOND=4
KBO_NAVER_TIMEOUT_MS=15000
KBO_REGISTRY_CONCURRENCY=2
KBO_REGISTRY_MAX_ATTEMPTS=3
KBO_REGISTRY_REQUESTS_PER_SECOND=2
KBO_REGISTRY_TIMEOUT_MS=15000
KBO_RECORD_CORRECTION_AUTO_SYNC=true
KBO_RECORD_CORRECTION_MAX_ATTEMPTS=3
KBO_RECORD_CORRECTION_REQUESTS_PER_SECOND=2
KBO_RECORD_CORRECTION_TIMEOUT_MS=15000
KBO_RECORD_CORRECTION_SYNC_INTERVAL_MS=86400000
KBO_RECORD_CORRECTION_RETRY_INTERVAL_MS=21600000
# 기존 V2 volume을 읽기 전용 전환 source로 열 때만 사용한다.
KBO_V2_VOLUME_NAME=kbo-workbench_postgres-data
KBO_V2_DB_PORT=5434
